    "Your Year in Travel": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouw reisjaar"
          }
        }
      }
    },
    "Your places will appear as your photos are scanned — or add countries you've visited by hand.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je plaatsen verschijnen terwijl je foto's worden gescand — of voeg handmatig landen toe die je hebt bezocht."
          }
        }
      }
    },
    "Your travel history, automatically": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je reisgeschiedenis, automatisch"
          }
        }
      }
    },
    "Your travel personality": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je reispersoonlijkheid"
          }
        }
      }
    },
    "Your travel personality is calculated entirely on‑device from where your photos were taken. Everyday photos within 50 km of home are excluded so it reflects your travels.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je reispersoonlijkheid wordt volledig op je toestel berekend op basis van waar je foto's zijn genomen. Alledaagse foto's binnen 50 km van huis worden uitgesloten zodat het je reizen weerspiegelt."
          }
        }
      }
    },
