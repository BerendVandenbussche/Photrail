      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je reispersoonlijkheid wordt volledig op je toestel berekend op basis van waar je foto's zijn genomen. Alledaagse foto's binnen 50 km van huis worden uitgesloten zodat het je reizen weerspiegelt."
          }
        }
      }
